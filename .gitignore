# 构建产物
.build/
build/
BuildOutput/
*.xcodeproj/xcuserdata/
.DS_Store

# 构建脚本目录（Build/ 不是产物；注意 macOS 上 build/ 与 Build/ 是同一目录，需反选）
!Build/

# 本地工具配置（skills 随仓库共享，其余本地文件忽略）
.myflicker/*
!.myflicker/skills/
!.myflicker/skills/**
*.local.json

# 本地 Agent 工作记忆（不入库）
.workbuddy/

# 按架构交叉编译的构建目录
.build-arm64/
.build-x86_64/

# UI 草图 Web 构建依赖
Web/sketch/node_modules/
Web/sketch/.vite/
